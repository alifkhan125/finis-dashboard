# Backend API Base URL
VITE_API_BASE_URL=

# Frontend Dashboard App URL
VITE_APP_URL=

# Environment (development | staging | production)
VITE_ENV=development

# Use Mock API (true for mock data, false to connect to real backend)
VITE_USE_MOCK_API=false

# Google Maps API Key (Optional, for geofencing/map features)
VITE_GOOGLE_MAPS_API_KEY=

# App Version
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_FEATURE_GEOFENCING=true
VITE_FEATURE_CHAT=true
VITE_FEATURE_REPORTS=true
VITE_FEATURE_PAYROLL=true
